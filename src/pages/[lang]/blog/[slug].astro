---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { ui, formatDate, readingMinutes, type Lang } from '../../../i18n';
import { postLang, postSlug, tagHref } from '../../../posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { lang: postLang(post), slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = ui[lang].blog;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = readingMinutes(post.body, lang);
---

<Base lang={lang} title={post.data.title} description={post.data.description}>
  <div class="container layout">
    <article>
      <a class="back" href={`/${lang}/blog/`}>← {t.back}</a>
      <header>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          <span>·</span>
          <span>{t.minutes(minutes)}</span>
        </p>
        {post.data.tags.length > 0 && (
          <p class="tags">{post.data.tags.map((tag) => <a class="tag" href={tagHref(lang, tag)}>{tag}</a>)}</p>
        )}
      </header>

      {post.data.legacy && (
        <p class="legacy">
          {t.legacyBanner} {post.data.date.getFullYear()}{t.legacyBannerTail}
        </p>
      )}

      <div class="prose">
        <Content />
      </div>

      <aside class="cta">
        <div>
          <strong>{t.ctaTitle}</strong>
          <p>{t.ctaText}</p>
        </div>
        <a class="btn btn-primary" href={`/${lang}/mentoring/`}>
          {ui[lang].nav.mentoring}
          <Icon name="arrow" size={18} />
        </a>
      </aside>
    </article>

    {toc.length > 2 && (
      <nav class="toc" aria-label={t.toc}>
        <p>{t.toc}</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 220px;
    justify-content: center;
    gap: 56px;
    padding-top: 40px;
  }
  .back {
    display: inline-block;
    font-size: 14.5px;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 14px;
  }
  .meta {
    display: flex;
    gap: 8px;
    color: var(--faint);
    font-size: 14.5px;
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
  }
  a.tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  header {
    padding-bottom: 28px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }
  .legacy {
    margin: 0 0 32px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--warn-soft);
    color: var(--warn-ink);
    font-size: 14.5px;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 64px;
    padding: 24px 28px;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }
  .cta strong {
    font-size: 17px;
  }
  .cta p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 15px;
  }
  .cta .btn {
    flex: none;
  }
  .toc {
    position: sticky;
    top: 96px;
    align-self: start;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    font-size: 13.5px;
    padding-top: 52px;
  }
  .toc p {
    margin: 0 0 10px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 12px;
    border-left: 1px solid var(--border);
  }
  .toc li {
    margin: 6px 0;
    line-height: 1.45;
  }
  .toc .d3 {
    padding-left: 12px;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--accent);
  }

  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 760px);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .layout {
      padding-top: 24px;
    }
    .cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
  }
</style>
