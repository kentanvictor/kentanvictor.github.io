---
import { ui, switchPath, SITE, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  altPath?: string;
}
const { lang, altPath } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const links = [
  { href: `/${lang}/`, label: t.nav.home, match: (p: string) => p === `/${lang}/` || p === `/${lang}` },
  { href: `/${lang}/blog/`, label: t.nav.blog, match: (p: string) => p.startsWith(`/${lang}/blog`) },
  { href: `/${lang}/about/`, label: t.nav.about, match: (p: string) => p.startsWith(`/${lang}/about`) },
  { href: `/${lang}/mentoring/`, label: t.nav.mentoring, match: (p: string) => p.startsWith(`/${lang}/mentoring`) },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={`/${lang}/`}>
      <img src="/images/avatar.png" alt="" width="32" height="32" />
      <span>{SITE.name}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="tools">
      <a class="tool lang" href={altPath ?? switchPath(path, lang)} hreflang={lang === 'zh' ? 'en' : 'zh-CN'} aria-label={t.switchLabel}>{t.switchTo}</a>
      <button class="tool" type="button" id="theme-toggle" aria-label={t.themeLabel} title={t.themeLabel}>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 17px;
    color: var(--text);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand img {
    border-radius: 50%;
    object-fit: cover;
  }
  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .nav a {
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }
  .nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    min-width: 34px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
  }
  .tool:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  button.tool {
    padding: 0;
  }
  :global(:root[data-theme='dark']) .sun,
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }

  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      height: auto;
      padding-top: 10px;
      padding-bottom: 6px;
      row-gap: 6px;
    }
    .tools {
      margin-left: auto;
    }
    .nav {
      order: 3;
      width: 100%;
      margin: 0 -12px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav {
      margin: 0 -8px;
      gap: 0;
    }
    .nav a {
      font-size: 14.5px;
      padding: 6px 9px;
    }
  }
</style>
